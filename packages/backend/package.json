{
  "name": "@cglabs/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/worker.js",
  "scripts": {
    "build": "node build.js",
    "dev": "node build.js && wrangler dev --ip 0.0.0.0 --port 8787",
    "deploy": "node build.js && wrangler deploy",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "@cglabs/shared": "*",
    "@nestjs/common": "^10.3.8",
    "@nestjs/core": "^10.3.8",
    "better-sqlite3": "^9.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "drizzle-orm": "^0.30.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240512.0",
    "@types/better-sqlite3": "^7.6.10",
    "@types/node": "^20.12.12",
    "drizzle-kit": "^0.21.4",
    "esbuild": "^0.21.3",
    "typescript": "^5.4.5",
    "wrangler": "^3.57.1"
  }
}
